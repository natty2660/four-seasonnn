<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="24dp"
    android:keepScreenOn="true">

    <!-- Top Restaurant Branding -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="32dp">

        <TextView
            android:id="@+id/tv_brand_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#242014"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="👑 FOUR SEASON VIP LOUNGE"
            android:textColor="#FCF6BA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_incoming_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="INCOMING VIP CALL"
            android:textColor="#D4AF37"
            android:textSize="20sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Call Details Card -->
    <LinearLayout
        android:id="@+id/center_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#161616"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Glowing Ring Indicator -->
        <TextView
            android:id="@+id/tv_bell_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/tv_table_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="VIP-1"
            android:textColor="#FCF6BA"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_table_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Table Name"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_call_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#2E1C12"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="REQUEST: GENERAL ASSISTANCE"
            android:textColor="#FFA726"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_escalation_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#3B1212"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="⚡ ESCALATED TO ALL WAITERS (45s)"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_ringing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ringing continuously on alarm volume..."
            android:textColor="#A3A3A3"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Buttons: Accept / Mute -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btn_accept_call"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="#10B981"
            android:text="✔ ACCEPT / I'M ON MY WAY"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mute_sound"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#262626"
            android:text="🔕 Mute Alarm Sound"
            android:textColor="#A3A3A3"
            android:textSize="14sp" />
    </LinearLayout>

</RelativeLayout>
