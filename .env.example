# Server Port & Runtime Environment
PORT=3000
NODE_ENV=development

# Admin Authentication
# Change this in production. Default is primecafe2026
ADMIN_PASSWORD="primecafe2026"
ADMIN_SECRET="prime_buna_ethiopia_secret_key_2026_change_in_production"

# Public URL used to encode permanent QR codes
# Dev: http://localhost:3000
# Prod: https://primecafe.et or https://your-app.vercel.app
PUBLIC_BASE_URL="http://localhost:3000"

# Database Storage
# Serverless defaults to /tmp/prime_cafe_db.json
# Local development defaults to ./data/prime_cafe_db.json
DB_PATH=""

# Optional hosted relational database (e.g. Neon, Supabase, Vercel Postgres)
# If set, can be used for multi-region Postgres replication.
DATABASE_URL=""

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
